# ===========================================
# 粉丝社群平台 - 环境变量配置示例
# 复制此文件为 .env 并填入实际值
# ===========================================

# ===========================================
# 运行环境（必填）
# ===========================================
# 可选值：development / production / testing
# 生产环境必须设置为 production
ENV=development

# ===========================================
# JWT 配置（生产环境必填）
# ===========================================
# JWT 签名密钥，生产环境必须通过环境变量设置
# 生成随机密钥命令：python -c "import secrets; print(secrets.token_hex(32))"
# 密钥要求：
#   - 至少 32 个字符
#   - 使用随机字符串
#   - 禁止在生产环境使用默认值
#
# ⚠️ 重要：生产环境必须设置此值，否则应用无法启动
SECRET_KEY=

# JWT 算法（默认 HS256，无需修改）
ALGORITHM=HS256

# Token 有效期，单位：分钟（默认 7 天）
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ===========================================
# 数据库配置
# ===========================================
# 开发环境：SQLite
DATABASE_URL=sqlite:///./fan_community.db

# 生产环境示例：MySQL
# DATABASE_URL=mysql+pymysql://user:password@localhost:3306/fan_community

# ===========================================
# CORS 配置（生产环境必填）
# ===========================================
# CORS_ORIGINS 用于指定允许访问 API 的前端域名
# 多个域名用逗号分隔
#
# ⚠️ 安全要求：
#   - 生产环境必须设置此值，否则应用无法启动
#   - 禁止使用通配符 (*) 或 null
#   - 禁止使用 localhost/127.0.0.1（生产环境）
#   - 建议使用 HTTPS
#
# 开发环境示例：
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173
#
# 生产环境示例：
# CORS_ORIGINS=https://example.com,https://app.example.com,https://admin.example.com

# ===========================================
# 图片上传配置
# ===========================================
# 图片存储目录
UPLOAD_DIR=uploads

# 单张图片最大大小（字节），默认 5MB
MAX_IMAGE_SIZE=5242880

# 单篇帖子最多图片数
MAX_IMAGES_PER_POST=9

# ===========================================
# 审计日志配置
# ===========================================
# 审计日志存储目录
AUDIT_LOG_DIR=logs/audit

# 审计日志保留天数（默认 365 天）
AUDIT_LOG_RETENTION_DAYS=365

# ===========================================
# 验证码配置
# ===========================================
# 验证码有效期，单位：分钟（默认 15 分钟）
CODE_EXPIRE_MINUTES=15

# ===========================================
# SMTP 邮件配置（生产环境密码重置功能需要）
# ===========================================
# 开发环境可以不配置，验证码将直接返回便于调试
# 生产环境必须配置，否则密码重置功能无法正常工作
#
# SMTP 服务器地址
SMTP_HOST=
# SMTP 端口（默认 587）
SMTP_PORT=587
# SMTP 用户名
SMTP_USER=
# SMTP 密码
SMTP_PASSWORD=
# 发件人地址
SMTP_FROM=
# 是否使用 TLS（默认 True）
SMTP_USE_TLS=True
#
# 常见 SMTP 配置示例：
#
# QQ 邮箱：
# SMTP_HOST=smtp.qq.com
# SMTP_PORT=587
# SMTP_USER=your_qq@qq.com
# SMTP_PASSWORD=授权码（非QQ密码）
# SMTP_FROM=your_qq@qq.com
#
# 163 邮箱：
# SMTP_HOST=smtp.163.com
# SMTP_PORT=465
# SMTP_USER=your_name@163.com
# SMTP_PASSWORD=授权码
# SMTP_FROM=your_name@163.com
#
# Gmail：
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_name@gmail.com
# SMTP_PASSWORD=应用专用密码
# SMTP_FROM=your_name@gmail.com

# ===========================================
# 第三方登录 OAuth 配置（v2 新增）
# ===========================================
# 支持平台：微信 / 抖音 / 支付宝
# 协议标准：OAuth 2.0 授权码模式

# ─── OAuth 运行模式 ───
# Mock 模式开关：true=模拟OAuth流程（开发调试），false=调用真实第三方接口
# ⚠️ 重要：生产环境必须设置为 false，否则应用会拒绝启动
# 开发阶段推荐 true，无需企业认证即可完成全链路联调
OAUTH_MOCK_MODE=true

# 支付宝沙箱开关：true=使用支付宝沙箱环境
# 仅在 OAUTH_MOCK_MODE=true 时对支付宝生效
# 开启后支付宝走沙箱真实接口（需配置沙箱凭证），微信/抖音仍走 Mock
ALIPAY_SANDBOX=false

# 前端回调地址（用于 OAuth 回调页与 Mock 授权页）
# 后端会拼接：{OAUTH_FRONTEND_URL}/oauth/callback/{provider}
OAUTH_FRONTEND_URL=http://localhost:5173

# Mock 授权码有效期（秒），默认 5 分钟
OAUTH_MOCK_CODE_EXPIRE_SECONDS=300

# ─── 微信（开放平台 - 网站应用） ───
# 申请地址：https://open.weixin.qq.com/
# AppID 格式：wx + 16位十六进制
# AppSecret 为 32 位十六进制
# Mock 模式下可不配置
WECHAT_CLIENT_ID=
WECHAT_CLIENT_SECRET=

# ─── 抖音（开放平台 - 网站应用） ───
# 申请地址：https://open.douyin.com/
# ClientKey / ClientSecret 在开放平台应用详情页获取
# Mock 模式下可不配置
DOUYIN_CLIENT_ID=
DOUYIN_CLIENT_SECRET=

# ─── 支付宝（生产） ───
# 申请地址：https://open.alipay.com/
# AppID 为 16 位数字
# 应用私钥/支付宝公钥为 RSA2 PEM 格式（多行 Base64）
# Mock 模式下可不配置
ALIPAY_APP_ID=
ALIPAY_APP_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=

# ─── 支付宝沙箱 ───
# 从 https://open.alipay.com/develop/sandbox/app 获取
# 凭证格式与生产环境一致，但仅用于沙箱环境调用
# 仅在 ALIPAY_SANDBOX=true 时使用
ALIPAY_SANDBOX_APP_ID=
ALIPAY_SANDBOX_APP_PRIVATE_KEY=
ALIPAY_SANDBOX_PUBLIC_KEY=

